# Copy to ~/gitlab-agent/secrets/env on the worker host, chmod 600.
# Read by the systemd units (EnvironmentFile), gl.py and askpass.sh. Never passed to the agent.

# Token of the bot's GitLab user (a group service account works well), scope `api`.
GITLAB_TOKEN=
BOT_USERNAME=claude-bot
# Commit e-mail of the bot (for a service account: its noreply address from the GitLab profile).
BOT_EMAIL=

# The only group the worker may touch, and the projects inside it (names, not full paths).
GITLAB_GROUP=acme
KB_PROJECT=kb
TEAM_PROJECT=team
WORKER_PROJECT=gitlab-agent

# Who gets pinged in the daily report and about stuck jobs.
OWNER_USERNAME=alice

# Claude Code auth for headless runs: either a long-lived OAuth token (`claude setup-token`) or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=            model for work with people (default: Claude Code's default)
# CLAUDE_MODEL_ROUTINE=sonnet   model for knowledge-base chores (inbox, stale, digest)
# DAILY_BUDGET_USD=15      estimated spend per day; a run with unknown cost counts as $2
# MCP_*                    secrets referenced as ${MCP_*} in agent/mcp.json; they reach MCP servers only
