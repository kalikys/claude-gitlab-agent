# ~/.config/systemd/user/gitlab-agent-poll.service of the worker's Unix user (systemd --user).
[Unit]
Description=GitLab agent: опрос задач
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/gitlab-agent/secrets/env
Environment=AGENT_HOME=%h/gitlab-agent
WorkingDirectory=%h/gitlab-agent/app
ExecStart=/usr/bin/python3 %h/gitlab-agent/app/poll.py
TimeoutStartSec=2h
